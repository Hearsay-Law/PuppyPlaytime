<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+ draws apps edge-to-edge by default; keep the WebView clear of the status/nav bars. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
